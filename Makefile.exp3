# Exp3 independent mobility. Formal runs are order-only after the last Exp2 run,
# so a newer Exp2 output does not rebuild them. One Exp3 VM is locked, so smoke
# targets stay serial.

EXP3_ROOT := results/extended/exp3
EXP3_P1_NODES := core agg1 agg2 acc1 acc2 acc3 acc4 acc5 acc6 producer1 consumer1
EXP3_P2_NODES := $(EXP3_P1_NODES) producer2 consumer2
EXP3_P4_NODES := $(EXP3_P2_NODES) producer3 consumer3 producer4 consumer4
EXP3_FULL_RUNS := r1 r2 r3 r4 r5

EXP3_VM_PREREQS := scripts/run-in-vm.sh \
	box/solution/solution.$(PROVIDER).box \
	experiment/app/producer.cpp \
	experiment/app/consumer.cpp \
	experiment/app/optoflood-daemon.cpp \
	experiment/app/guard_flood_id.hpp \
	experiment/app/trust-schema.conf \
	experiment/extended/exp3/Vagrantfile \
	experiment/extended/exp3/Makefile \
	experiment/tool/common/exp.py \
	experiment/tool/common/handoff_schedule.py \
	experiment/tool/exp3/exp3_driver.py \
	experiment/tool/exp3/exp3_config.py \
	experiment/tool/exp3/exp3_processes.py \
	experiment/tool/exp3/check_exp3_evidence.py

define exp3_outputs
$(1)/campaign.txt \
$(1)/params.txt \
$(1)/handoffs.txt \
$(1)/topology.txt \
$(1)/schedules.txt \
$(1)/observation_ends.txt \
$(1)/process-health.txt \
$(1)/capture-health.txt \
$(1)/timing-summary.txt \
$(1)/trust-schema.conf \
$(foreach pair,$(2),$(1)/producer$(pair).log $(1)/consumer$(pair).log $(1)/optoflood_producer$(pair).log $(1)/optoflood_consumer$(pair).log $(1)/certs/producer$(pair).cert) \
$(foreach node,$(3),$(1)/pcap_nodes/$(node).pcap $(1)/tcpdump_$(node).log $(1)/minindn-logs/$(node)/nfd.log $(1)/minindn-logs/$(node)/nlsr.log)
endef

define exp3_smoke_rule
EXP3_$(1)_SMOKE_OUTPUTS := $$(call exp3_outputs,$(EXP3_ROOT)/$(2)/smoke,$(3),$(4))

$$(EXP3_$(1)_SMOKE_OUTPUTS) &: $$(EXP3_VM_PREREQS) | test/.solution_pass.$$(PROVIDER)
	RUN_IN_VM_PROFILE=exp3 MOBILITY_LOG_NODES="$(4)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) EXP3_POPULATION='$(2)' EXP3_SCHEDULE='smoke' EXP3_RUN_ID='smoke' EXP_REQUEST_INTERVAL_MS='20' make exp3" sh $$(EXP3_VM_PREREQS) $$@

.PHONY: experiment-exp3-$(2)-smoke check-exp3-$(2)-smoke

experiment-exp3-$(2)-smoke: $$(EXP3_$(1)_SMOKE_OUTPUTS)

check-exp3-$(2)-smoke:
	python3 -m experiment.tool.exp3.check_exp3_evidence $(EXP3_ROOT)/$(2)/smoke
endef

$(eval $(call exp3_smoke_rule,P1,p1,1,$(EXP3_P1_NODES)))
$(eval $(call exp3_smoke_rule,P2,p2,1 2,$(EXP3_P2_NODES)))
$(eval $(call exp3_smoke_rule,P4,p4,1 2 3 4,$(EXP3_P4_NODES)))

define exp3_full_rule
EXP3_$(1)_$(2)_OUTPUTS := $$(call exp3_outputs,$(EXP3_ROOT)/$(3)/$(2),$(4),$(5))

$$(EXP3_$(1)_$(2)_OUTPUTS) &: $$(EXP3_VM_PREREQS) | $(6)
	RUN_IN_VM_PROFILE=exp3 MOBILITY_LOG_NODES="$(5)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) EXP3_POPULATION='$(3)' EXP3_SCHEDULE='full' EXP3_RUN_ID='$(2)' EXP_REQUEST_INTERVAL_MS='20' make exp3" sh $$(EXP3_VM_PREREQS) $$@

.PHONY: experiment-exp3-$(3)-$(2) check-exp3-$(3)-$(2)

experiment-exp3-$(3)-$(2): $$(EXP3_$(1)_$(2)_OUTPUTS)

check-exp3-$(3)-$(2):
	python3 -m experiment.tool.exp3.check_exp3_evidence $(EXP3_ROOT)/$(3)/$(2)
endef

EXP3_CHAIN_PREV := $(EXP2_FORMAL_LAST)

define queue_exp3_p1
$(eval $(call exp3_full_rule,P1,$(1),p1,1,$(EXP3_P1_NODES),$(EXP3_CHAIN_PREV)))
$(eval EXP3_CHAIN_PREV := $(EXP3_P1_$(1)_OUTPUTS))
endef

define queue_exp3_p2
$(eval $(call exp3_full_rule,P2,$(1),p2,1 2,$(EXP3_P2_NODES),$(EXP3_CHAIN_PREV)))
$(eval EXP3_CHAIN_PREV := $(EXP3_P2_$(1)_OUTPUTS))
endef

define queue_exp3_p4
$(eval $(call exp3_full_rule,P4,$(1),p4,1 2 3 4,$(EXP3_P4_NODES),$(EXP3_CHAIN_PREV)))
$(eval EXP3_CHAIN_PREV := $(EXP3_P4_$(1)_OUTPUTS))
endef

$(foreach run,$(EXP3_FULL_RUNS),$(call queue_exp3_p1,$(run)))
$(foreach run,$(EXP3_FULL_RUNS),$(call queue_exp3_p2,$(run)))
$(foreach run,$(EXP3_FULL_RUNS),$(call queue_exp3_p4,$(run)))

# Formal VM runs only. One population finishes before the next; smoke and pilot stay out.
.PHONY: experiment-exp3-p1-full experiment-exp3-p2-full experiment-exp3-p4-full experiment-exp3

experiment-exp3-p1-full: $(EXP3_P1_r5_OUTPUTS)

experiment-exp3-p2-full: $(EXP3_P2_r5_OUTPUTS)

experiment-exp3-p4-full: $(EXP3_P4_r5_OUTPUTS)

experiment-exp3: $(EXP3_CHAIN_PREV)

EXP3_FORMAL_EVIDENCE := $(foreach run,$(EXP3_FULL_RUNS),$(EXP3_P1_$(run)_OUTPUTS) $(EXP3_P2_$(run)_OUTPUTS) $(EXP3_P4_$(run)_OUTPUTS))
EXP3_CAMPAIGN_OUTPUTS := $(EXP3_ROOT)/analysis/campaign/campaign_status.txt \
	$(EXP3_ROOT)/analysis/campaign/events.csv \
	$(EXP3_ROOT)/analysis/campaign/prefix_rfv.csv \
	$(EXP3_ROOT)/analysis/campaign/network_overhead.csv \
	$(EXP3_ROOT)/analysis/campaign/run_summary.csv \
	$(EXP3_ROOT)/analysis/campaign/timing_audit.csv \
	$(EXP3_ROOT)/analysis/campaign/population_comparison.csv

$(EXP3_CAMPAIGN_OUTPUTS) &: experiment/tool/exp3/run_exp3_analysis.py \
	experiment/tool/exp3/exp3_metrics.py \
	experiment/tool/exp3/exp3_config.py \
	experiment/tool/exp3/check_exp3_evidence.py \
	experiment/tool/analysis/mobility_event_metrics.py \
	experiment/tool/analysis/run_mobility_event_analysis.py \
	experiment/tool/analysis/extract_overhead_csv.py \
	experiment/tool/resources/ndn.lua \
	$(EXP3_FORMAL_EVIDENCE)
	python3 -m experiment.tool.exp3.run_exp3_analysis --campaign

# One P=4 full sequence in a non-formal directory. Seed 1 matches formal p4/r1.
EXP3_P4_PILOT_DIR := $(EXP3_ROOT)/p4/pilot
EXP3_P4_PILOT_OUTPUTS := $(call exp3_outputs,$(EXP3_P4_PILOT_DIR),1 2 3 4,$(EXP3_P4_NODES))

$(EXP3_P4_PILOT_OUTPUTS) &: $(EXP3_VM_PREREQS) | test/.solution_pass.$(PROVIDER)
	RUN_IN_VM_PROFILE=exp3 MOBILITY_LOG_NODES="$(EXP3_P4_NODES)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) EXP3_POPULATION='p4' EXP3_SCHEDULE='full' EXP3_RUN_ID='pilot' EXP3_RUN_SEED='1' EXP_REQUEST_INTERVAL_MS='20' make exp3" sh $(EXP3_VM_PREREQS) $@

.PHONY: experiment-exp3-p4-pilot check-exp3-p4-pilot

experiment-exp3-p4-pilot: $(EXP3_P4_PILOT_OUTPUTS)

check-exp3-p4-pilot:
	python3 -m experiment.tool.exp3.check_exp3_evidence $(EXP3_P4_PILOT_DIR)

# Single-run and pilot helpers. The formal campaign tables and paper figures
# are the file rules used by `analyse` and `plot`.
.PHONY: analyze-exp3-run analyze-exp3-p4-pilot plot-exp3-pilot

analyze-exp3-run:
	python3 -m experiment.tool.exp3.run_exp3_analysis $(EXP3_POPULATION) $(EXP3_RUN_ID)

analyze-exp3-p4-pilot:
	python3 -m experiment.tool.exp3.run_exp3_analysis p4 pilot

plot-exp3-pilot:
	python3 -m experiment.tool.exp3.plot_exp3 --pilot
