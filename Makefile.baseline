# Rules to run baseline experiments.
#
# Each profile scales the four NLSR timers by a common factor, 1.0 down to 0.6:
# hello-interval, adj-lsa-build-interval, routing-calc-interval and
# sync-interest-lifetime. The profile name carries all four in seconds
# (hNN-aNN-rNN-sNN); nlsr.conf takes the first three in seconds and
# sync-interest-lifetime in milliseconds, which is why the environment variable
# for it is named with an _MS suffix and carries a value a thousand times larger.
#
# sync-interest-lifetime governs how often PSync re-expresses a sync Interest,
# at half the lifetime. It bounds how long a freshly built LSA waits before a
# neighbour asks for it, and so sits on the critical path of baseline recovery
# alongside the other three timers.
#
# Repetition: five independent runs of one producer round trip (8 handoffs).
# Runs sample NLSR_HANDOFF_INTERVAL_* independently. There is no paired seed.
# VM recipes are chained by order-only prerequisites so `make -j` stays serial.
# Order within a profile is r1..r5, then the next profile:
#   g0/r1 .. g0/r5, g1/r1 .. g1/r5, ..., g4/r1 .. g4/r5.

BASELINE_DEFAULT_DIR = results/baseline/g0-h60-a10-r15-s60
BASELINE_PROFILE_LIST := g0-h60-a10-r15-s60 g1-h54-a9-r14-s54 g2-h48-a8-r12-s48 g3-h42-a7-r10-s42 g4-h36-a6-r9-s36

EXPERIMENT_RUN_IDS := r1 r2 r3 r4 r5
_of_empty :=
_of_space := $(_of_empty) $(_of_empty)
_of_comma := ,
BASELINE_PROFILE_NAMES := $(subst $(_of_space),$(_of_comma),$(BASELINE_PROFILE_LIST))
EXPERIMENT_RUN_CSV := $(subst $(_of_space),$(_of_comma),$(EXPERIMENT_RUN_IDS))

# Shared with Makefile.solution. Makefile.exp1 keeps its own K=16 schedule.
MAIN_HANDOFF_COUNT := 8
MAIN_HANDOFF_SEQUENCE := acc2,acc3,acc4,acc5,acc6,acc5,acc4,acc3,acc2
MAIN_HANDOFF_INTERVAL_BASE := 90
MAIN_HANDOFF_INTERVAL_JITTER := 60
MAIN_HANDOFF_ENV := NLSR_HANDOFF_COUNT='$(MAIN_HANDOFF_COUNT)' NLSR_HANDOFF_INTERVAL_BASE='$(MAIN_HANDOFF_INTERVAL_BASE)' NLSR_HANDOFF_INTERVAL_JITTER='$(MAIN_HANDOFF_INTERVAL_JITTER)' NLSR_HANDOFF_SEQUENCE='$(MAIN_HANDOFF_SEQUENCE)'

EXPERIMENT_RUN_FILES := consumer_capture.pcap pcap_nodes/core.pcap pcap_nodes/agg1.pcap pcap_nodes/agg2.pcap pcap_nodes/acc1.pcap pcap_nodes/acc2.pcap pcap_nodes/acc3.pcap pcap_nodes/acc4.pcap pcap_nodes/acc5.pcap pcap_nodes/acc6.pcap pcap_nodes/producer.pcap pcap_nodes/consumer.pcap params.txt handoffs.txt

baseline_run_outputs = $(addprefix results/baseline/$(1)/$(2)/,$(EXPERIMENT_RUN_FILES))

BASELINE_VM_ORDER := $(foreach profile,$(BASELINE_PROFILE_LIST),$(foreach run,$(EXPERIMENT_RUN_IDS),$(profile)/$(run)))
BASELINE_RAW_OUTPUTS := $(foreach profile,$(BASELINE_PROFILE_LIST),$(foreach run,$(EXPERIMENT_RUN_IDS),$(call baseline_run_outputs,$(profile),$(run))))
BASELINE_LAST_RUN_OUTPUTS := $(call baseline_run_outputs,$(lastword $(BASELINE_PROFILE_LIST)),$(lastword $(EXPERIMENT_RUN_IDS)))

BASELINE_EXPERIMENT_INPUTS = box/baseline/baseline.$(PROVIDER).box \
                             experiment/app/producer.cpp \
                             experiment/app/consumer.cpp \
                             experiment/app/trust-schema.conf \
                             experiment/baseline/Vagrantfile \
                             experiment/baseline/Makefile \
                             experiment/tool/exp.py

BASELINE_PROFILE_ENV_g0-h60-a10-r15-s60 := NLSR_HELLO_INTERVAL='60' NLSR_ADJ_LSA_BUILD_INTERVAL='10' NLSR_ROUTING_CALC_INTERVAL='15' NLSR_SYNC_INTEREST_LIFETIME_MS='60000' NLSR_TUNING_PROFILE='g0-h60-a10-r15-s60'
BASELINE_PROFILE_ENV_g1-h54-a9-r14-s54 := NLSR_HELLO_INTERVAL='54' NLSR_ADJ_LSA_BUILD_INTERVAL='9' NLSR_ROUTING_CALC_INTERVAL='14' NLSR_SYNC_INTEREST_LIFETIME_MS='54000' NLSR_TUNING_PROFILE='g1-h54-a9-r14-s54'
BASELINE_PROFILE_ENV_g2-h48-a8-r12-s48 := NLSR_HELLO_INTERVAL='48' NLSR_ADJ_LSA_BUILD_INTERVAL='8' NLSR_ROUTING_CALC_INTERVAL='12' NLSR_SYNC_INTEREST_LIFETIME_MS='48000' NLSR_TUNING_PROFILE='g2-h48-a8-r12-s48'
BASELINE_PROFILE_ENV_g3-h42-a7-r10-s42 := NLSR_HELLO_INTERVAL='42' NLSR_ADJ_LSA_BUILD_INTERVAL='7' NLSR_ROUTING_CALC_INTERVAL='10' NLSR_SYNC_INTEREST_LIFETIME_MS='42000' NLSR_TUNING_PROFILE='g3-h42-a7-r10-s42'
BASELINE_PROFILE_ENV_g4-h36-a6-r9-s36 := NLSR_HELLO_INTERVAL='36' NLSR_ADJ_LSA_BUILD_INTERVAL='6' NLSR_ROUTING_CALC_INTERVAL='9' NLSR_SYNC_INTEREST_LIFETIME_MS='36000' NLSR_TUNING_PROFILE='g4-h36-a6-r9-s36'

# $(1) profile, $(2) run id, $(3) order-only outputs of the previous VM run.
define emit_baseline_run
$(if $(BASELINE_PROFILE_ENV_$(1)),,$(error missing baseline profile environment for $(1)))
$(call baseline_run_outputs,$(1),$(2)) &: scripts/run-in-vm.sh $$(BASELINE_EXPERIMENT_INPUTS)$(if $(3), | $(3))
	RUN_IN_VM_CLEAR_LOCAL=1 RUN_IN_VM_REMOTE_MAKE="$(BASELINE_PROFILE_ENV_$(1)) $$(MAIN_HANDOFF_ENV) make all" sh $$^ $$@
endef

BASELINE_CHAIN_PREV :=

define queue_baseline_run
$(eval $(call emit_baseline_run,$(1),$(2),$(BASELINE_CHAIN_PREV)))
$(eval BASELINE_CHAIN_PREV := $(call baseline_run_outputs,$(1),$(2)))
endef

$(foreach profile,$(BASELINE_PROFILE_LIST),$(foreach run,$(EXPERIMENT_RUN_IDS),$(call queue_baseline_run,$(profile),$(run))))

# Host-side inputs for the per-handoff comparison. The % stem is <profile>/<run>.

results/baseline/%/consumer_capture.csv: results/baseline/%/consumer_capture.pcap experiment/tool/ndn.lua
	tshark -X lua_script:experiment/tool/ndn.lua -r "$<" -T fields -e frame.time_epoch -e frame.len -e ndn.type -e ndn.name -E separator=, -E header=y -E quote=d > "$@"

results/baseline/%/network_overhead.csv: experiment/tool/extract_overhead_csv.py \
                                        results/baseline/%/pcap_nodes/core.pcap \
                                        results/baseline/%/pcap_nodes/agg1.pcap \
                                        results/baseline/%/pcap_nodes/agg2.pcap \
                                        results/baseline/%/pcap_nodes/acc1.pcap \
                                        results/baseline/%/pcap_nodes/acc2.pcap \
                                        results/baseline/%/pcap_nodes/acc3.pcap \
                                        results/baseline/%/pcap_nodes/acc4.pcap \
                                        results/baseline/%/pcap_nodes/acc5.pcap \
                                        results/baseline/%/pcap_nodes/acc6.pcap \
                                        results/baseline/%/pcap_nodes/producer.pcap \
                                        results/baseline/%/pcap_nodes/consumer.pcap
	python3 $^ $@

results/baseline/%/disruption_metrics.txt: experiment/tool/compute_latency_metrics.py results/baseline/%/consumer_capture.csv results/baseline/%/handoffs.txt
	python3 $^ $@

results/baseline/%/overhead_total.txt: experiment/tool/compute_overhead_metrics.py results/baseline/%/network_overhead.csv results/baseline/%/handoffs.txt | experiment/tool/plot_overhead.py
	python3 $^ $@

BASELINE_METRIC_INPUTS := $(foreach profile,$(BASELINE_PROFILE_LIST),$(foreach run,$(EXPERIMENT_RUN_IDS),results/baseline/$(profile)/$(run)/disruption_metrics.txt results/baseline/$(profile)/$(run)/overhead_total.txt))

BASELINE_PROFILE_COMPARE_OUTPUTS := results/baseline/handoff_observations.csv \
                                   results/baseline/handoff_metric_audit.txt \
                                   results/baseline_disruption_comparison.pdf \
                                   results/baseline_forwarding_cost_ratio.pdf \
                                   results/baseline_nlsr_control_traffic.pdf

$(BASELINE_PROFILE_COMPARE_OUTPUTS) &: experiment/tool/handoff_metric_comparison.py $(BASELINE_METRIC_INPUTS)
	python3 experiment/tool/handoff_metric_comparison.py baseline --root-dir results/baseline --profiles "$(BASELINE_PROFILE_NAMES)" --runs "$(EXPERIMENT_RUN_CSV)" --observations results/baseline/handoff_observations.csv --audit results/baseline/handoff_metric_audit.txt --disruption-pdf results/baseline_disruption_comparison.pdf --fcr-pdf results/baseline_forwarding_cost_ratio.pdf --control-pdf results/baseline_nlsr_control_traffic.pdf
