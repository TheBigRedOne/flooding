# Exp2-A shared stream, N=2 and N=4. Formal runs are order-only after Exp1, so a
# newer Exp1 output does not rebuild them. One Exp2 VM is locked, so campaign
# targets run serially.

EXP2_WARMUP_S ?= 20
EXP2_TAIL_S ?= 30
EXP2_SHARED_ROOT := results/extended/exp2/shared
EXP2_N2_NODES := core agg1 agg2 acc1 acc2 acc3 acc4 acc5 acc6 producer consumer1 consumer2
EXP2_N4_NODES := $(EXP2_N2_NODES) consumer3 consumer4
EXP2_FULL_SEQUENCE := acc2,acc3,acc4,acc5,acc6,acc5,acc4,acc3,acc2
EXP2_FULL_RUNS := r1 r2 r3 r4 r5

EXP2_VM_PREREQS := scripts/run-in-vm.sh \
	box/solution/solution.$(PROVIDER).box \
	experiment/app/producer.cpp \
	experiment/app/consumer.cpp \
	experiment/app/optoflood-daemon.cpp \
	experiment/app/guard_flood_id.hpp \
	experiment/app/trust-schema.conf \
	experiment/extended/exp2/Vagrantfile \
	experiment/extended/exp2/Makefile \
	experiment/tool/common/exp.py \
	experiment/tool/exp2/exp2_shared_driver.py \
	experiment/tool/exp2/exp2_shared_config.py \
	experiment/tool/common/handoff_schedule.py \
	experiment/tool/exp2/check_exp2_shared_evidence.py

define exp2_shared_outputs
$(1)/campaign.txt \
$(1)/params.txt \
$(1)/handoffs.txt \
$(1)/topology.txt \
$(1)/producer.log \
$(1)/optoflood_producer.log \
$(foreach consumer,$(2),$(1)/$(consumer).log $(1)/optoflood_$(consumer).log) \
$(foreach node,$(3),$(1)/pcap_nodes/$(node).pcap) \
$(foreach node,$(3),$(1)/tcpdump_$(node).log) \
$(foreach node,$(3),$(1)/minindn-logs/$(node)/nfd.log $(1)/minindn-logs/$(node)/nlsr.log)
endef

comma := ,

EXP2_N2_SMOKE_OUTPUTS := $(call exp2_shared_outputs,$(EXP2_SHARED_ROOT)/n2/smoke,consumer1 consumer2,$(EXP2_N2_NODES))
EXP2_N4_SMOKE_OUTPUTS := $(call exp2_shared_outputs,$(EXP2_SHARED_ROOT)/n4/smoke,consumer1 consumer2 consumer3 consumer4,$(EXP2_N4_NODES))

$(EXP2_N2_SMOKE_OUTPUTS) &: $(EXP2_VM_PREREQS) | test/.solution_pass.$(PROVIDER)
	RUN_IN_VM_PROFILE=exp2 MOBILITY_LOG_NODES="$(EXP2_N2_NODES)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) NLSR_HANDOFF_COUNT='1' NLSR_HANDOFF_SEQUENCE='acc2,acc3' NLSR_HANDOFF_INTERVALS='$(EXP2_WARMUP_S),$(EXP2_TAIL_S)' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='60' EXP2_ACTIVE_CONSUMERS='consumer1,consumer2' EXP2_SCHEDULE='smoke' EXP2_RUN_ID='smoke' EXP2_WARMUP_S='$(EXP2_WARMUP_S)' EXP2_TAIL_S='$(EXP2_TAIL_S)' EXP_REQUEST_INTERVAL_MS='20' make exp2-shared" sh $(EXP2_VM_PREREQS) $@

$(EXP2_N4_SMOKE_OUTPUTS) &: $(EXP2_VM_PREREQS) | test/.solution_pass.$(PROVIDER)
	RUN_IN_VM_PROFILE=exp2 MOBILITY_LOG_NODES="$(EXP2_N4_NODES)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) NLSR_HANDOFF_COUNT='1' NLSR_HANDOFF_SEQUENCE='acc2,acc3' NLSR_HANDOFF_INTERVALS='$(EXP2_WARMUP_S),$(EXP2_TAIL_S)' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='60' EXP2_ACTIVE_CONSUMERS='consumer1,consumer2,consumer3,consumer4' EXP2_SCHEDULE='smoke' EXP2_RUN_ID='smoke' EXP2_WARMUP_S='$(EXP2_WARMUP_S)' EXP2_TAIL_S='$(EXP2_TAIL_S)' EXP_REQUEST_INTERVAL_MS='20' make exp2-shared" sh $(EXP2_VM_PREREQS) $@

define exp2_full_rule
EXP2_$(1)_$(2)_OUTPUTS := $$(call exp2_shared_outputs,$(EXP2_SHARED_ROOT)/$(3)/$(2),$(4),$(6))

$$(EXP2_$(1)_$(2)_OUTPUTS) &: $$(EXP2_VM_PREREQS) | $(7)
	RUN_IN_VM_PROFILE=exp2 MOBILITY_LOG_NODES="$(6)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) NLSR_HANDOFF_COUNT='8' NLSR_HANDOFF_SEQUENCE='$(EXP2_FULL_SEQUENCE)' NLSR_HANDOFF_INTERVALS='' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='60' EXP2_ACTIVE_CONSUMERS='$(subst +,$(comma),$(5))' EXP2_SCHEDULE='full' EXP2_RUN_ID='$(2)' EXP_REQUEST_INTERVAL_MS='20' make exp2-shared" sh $$(EXP2_VM_PREREQS) $$@

.PHONY: experiment-exp2-shared-$(3)-$(2) analyze-exp2-shared-$(3)-$(2) check-exp2-shared-$(3)-$(2)

experiment-exp2-shared-$(3)-$(2): $$(EXP2_$(1)_$(2)_OUTPUTS)

analyze-exp2-shared-$(3)-$(2):
	python3 -m experiment.tool.exp2.run_exp2_shared_analysis $(EXP2_SHARED_ROOT)/$(3)/$(2)

check-exp2-shared-$(3)-$(2):
	python3 -m experiment.tool.exp2.check_exp2_shared_evidence $(EXP2_SHARED_ROOT)/$(3)/$(2)
endef

EXP2_CHAIN_PREV := $(EXP1_LAST_OUTPUTS)

define queue_exp2_n2
$(eval $(call exp2_full_rule,N2,$(1),n2,consumer1 consumer2,consumer1+consumer2,$(EXP2_N2_NODES),$(EXP2_CHAIN_PREV)))
$(eval EXP2_CHAIN_PREV := $(EXP2_N2_$(1)_OUTPUTS))
endef

define queue_exp2_n4
$(eval $(call exp2_full_rule,N4,$(1),n4,consumer1 consumer2 consumer3 consumer4,consumer1+consumer2+consumer3+consumer4,$(EXP2_N4_NODES),$(EXP2_CHAIN_PREV)))
$(eval EXP2_CHAIN_PREV := $(EXP2_N4_$(1)_OUTPUTS))
endef

$(foreach run,$(EXP2_FULL_RUNS),$(call queue_exp2_n2,$(run)))
$(foreach run,$(EXP2_FULL_RUNS),$(call queue_exp2_n4,$(run)))

.PHONY: experiment-exp2-shared-n2-smoke experiment-exp2-shared-n4-smoke \
	check-exp2-shared-n2-smoke check-exp2-shared-n4-smoke \
	analyze-exp2-shared-n2-smoke analyze-exp2-shared-n4-smoke \
	experiment-exp2-shared-n2-full experiment-exp2-shared-n4-full

experiment-exp2-shared-n2-smoke: $(EXP2_N2_SMOKE_OUTPUTS)

experiment-exp2-shared-n4-smoke: $(EXP2_N4_SMOKE_OUTPUTS)

check-exp2-shared-n2-smoke:
	python3 -m experiment.tool.exp2.check_exp2_shared_evidence $(EXP2_SHARED_ROOT)/n2/smoke

check-exp2-shared-n4-smoke:
	python3 -m experiment.tool.exp2.check_exp2_shared_evidence $(EXP2_SHARED_ROOT)/n4/smoke

analyze-exp2-shared-n2-smoke:
	python3 -m experiment.tool.exp2.run_exp2_shared_analysis $(EXP2_SHARED_ROOT)/n2/smoke

analyze-exp2-shared-n4-smoke:
	python3 -m experiment.tool.exp2.run_exp2_shared_analysis $(EXP2_SHARED_ROOT)/n4/smoke

experiment-exp2-shared-n2-full: $(EXP2_N2_r5_OUTPUTS)

experiment-exp2-shared-n4-full: $(EXP2_N4_r5_OUTPUTS)

EXP2_DISTINCT_ROOT := results/extended/exp2/distinct

EXP2_N2_DISTINCT_SMOKE_OUTPUTS := $(call exp2_shared_outputs,$(EXP2_DISTINCT_ROOT)/n2/smoke,consumer1 consumer2,$(EXP2_N2_NODES))
EXP2_N4_DISTINCT_SMOKE_OUTPUTS := $(call exp2_shared_outputs,$(EXP2_DISTINCT_ROOT)/n4/smoke,consumer1 consumer2 consumer3 consumer4,$(EXP2_N4_NODES))

$(EXP2_N2_DISTINCT_SMOKE_OUTPUTS) &: $(EXP2_VM_PREREQS) | test/.solution_pass.$(PROVIDER)
	RUN_IN_VM_PROFILE=exp2 MOBILITY_LOG_NODES="$(EXP2_N2_NODES)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) NLSR_HANDOFF_COUNT='1' NLSR_HANDOFF_SEQUENCE='acc2,acc3' NLSR_HANDOFF_INTERVALS='$(EXP2_WARMUP_S),$(EXP2_TAIL_S)' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='60' EXP2_ACTIVE_CONSUMERS='consumer1,consumer2' EXP2_SCHEDULE='smoke' EXP2_RUN_ID='smoke' EXP2_WARMUP_S='$(EXP2_WARMUP_S)' EXP2_TAIL_S='$(EXP2_TAIL_S)' EXP2_DEMAND_PATTERN='distinct' EXP_REQUEST_INTERVAL_MS='20' make exp2-shared" sh $(EXP2_VM_PREREQS) $@

$(EXP2_N4_DISTINCT_SMOKE_OUTPUTS) &: $(EXP2_VM_PREREQS) | test/.solution_pass.$(PROVIDER)
	RUN_IN_VM_PROFILE=exp2 MOBILITY_LOG_NODES="$(EXP2_N4_NODES)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) NLSR_HANDOFF_COUNT='1' NLSR_HANDOFF_SEQUENCE='acc2,acc3' NLSR_HANDOFF_INTERVALS='$(EXP2_WARMUP_S),$(EXP2_TAIL_S)' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='60' EXP2_ACTIVE_CONSUMERS='consumer1,consumer2,consumer3,consumer4' EXP2_SCHEDULE='smoke' EXP2_RUN_ID='smoke' EXP2_WARMUP_S='$(EXP2_WARMUP_S)' EXP2_TAIL_S='$(EXP2_TAIL_S)' EXP2_DEMAND_PATTERN='distinct' EXP_REQUEST_INTERVAL_MS='20' make exp2-shared" sh $(EXP2_VM_PREREQS) $@

define exp2_distinct_full_rule
EXP2_DISTINCT_$(1)_$(2)_OUTPUTS := $$(call exp2_shared_outputs,$(EXP2_DISTINCT_ROOT)/$(3)/$(2),$(4),$(6))

$$(EXP2_DISTINCT_$(1)_$(2)_OUTPUTS) &: $$(EXP2_VM_PREREQS) | $(7)
	RUN_IN_VM_PROFILE=exp2 MOBILITY_LOG_NODES="$(6)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) NLSR_HANDOFF_COUNT='8' NLSR_HANDOFF_SEQUENCE='$(EXP2_FULL_SEQUENCE)' NLSR_HANDOFF_INTERVALS='' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='60' EXP2_ACTIVE_CONSUMERS='$(subst +,$(comma),$(5))' EXP2_SCHEDULE='full' EXP2_RUN_ID='$(2)' EXP2_DEMAND_PATTERN='distinct' EXP_REQUEST_INTERVAL_MS='20' make exp2-shared" sh $$(EXP2_VM_PREREQS) $$@

.PHONY: experiment-exp2-distinct-$(3)-$(2) check-exp2-distinct-$(3)-$(2)

experiment-exp2-distinct-$(3)-$(2): $$(EXP2_DISTINCT_$(1)_$(2)_OUTPUTS)

check-exp2-distinct-$(3)-$(2):
	python3 -m experiment.tool.exp2.check_exp2_shared_evidence --pattern distinct $(EXP2_DISTINCT_ROOT)/$(3)/$(2)
endef

define queue_exp2_distinct_n2
$(eval $(call exp2_distinct_full_rule,N2,$(1),n2,consumer1 consumer2,consumer1+consumer2,$(EXP2_N2_NODES),$(EXP2_CHAIN_PREV)))
$(eval EXP2_CHAIN_PREV := $(EXP2_DISTINCT_N2_$(1)_OUTPUTS))
endef

define queue_exp2_distinct_n4
$(eval $(call exp2_distinct_full_rule,N4,$(1),n4,consumer1 consumer2 consumer3 consumer4,consumer1+consumer2+consumer3+consumer4,$(EXP2_N4_NODES),$(EXP2_CHAIN_PREV)))
$(eval EXP2_CHAIN_PREV := $(EXP2_DISTINCT_N4_$(1)_OUTPUTS))
endef

$(foreach run,$(EXP2_FULL_RUNS),$(call queue_exp2_distinct_n2,$(run)))
$(foreach run,$(EXP2_FULL_RUNS),$(call queue_exp2_distinct_n4,$(run)))

.PHONY: experiment-exp2-distinct-n2-smoke experiment-exp2-distinct-n4-smoke \
	check-exp2-distinct-n2-smoke check-exp2-distinct-n4-smoke \
	experiment-exp2-distinct-n2-full experiment-exp2-distinct-n4-full

experiment-exp2-distinct-n2-smoke: $(EXP2_N2_DISTINCT_SMOKE_OUTPUTS)

experiment-exp2-distinct-n4-smoke: $(EXP2_N4_DISTINCT_SMOKE_OUTPUTS)

check-exp2-distinct-n2-smoke:
	python3 -m experiment.tool.exp2.check_exp2_shared_evidence --pattern distinct $(EXP2_DISTINCT_ROOT)/n2/smoke

check-exp2-distinct-n4-smoke:
	python3 -m experiment.tool.exp2.check_exp2_shared_evidence --pattern distinct $(EXP2_DISTINCT_ROOT)/n4/smoke

experiment-exp2-distinct-n2-full: $(EXP2_DISTINCT_N2_r5_OUTPUTS)

experiment-exp2-distinct-n4-full: $(EXP2_DISTINCT_N4_r5_OUTPUTS)

.PHONY: analyze-exp2-distinct-n2-r1 analyze-exp2-distinct-n4-r1

analyze-exp2-distinct-n2-r1:
	python3 -m experiment.tool.exp2.run_exp2_distinct_analysis n2 r1

analyze-exp2-distinct-n4-r1:
	python3 -m experiment.tool.exp2.run_exp2_distinct_analysis n4 r1

EXP2_FORMAL_LAST := $(EXP2_CHAIN_PREV)
EXP2_SHARED_FORMAL_EVIDENCE := $(foreach run,$(EXP2_FULL_RUNS),$(EXP2_N2_$(run)_OUTPUTS) $(EXP2_N4_$(run)_OUTPUTS))
EXP2_DISTINCT_FORMAL_EVIDENCE := $(foreach run,$(EXP2_FULL_RUNS),$(EXP2_DISTINCT_N2_$(run)_OUTPUTS) $(EXP2_DISTINCT_N4_$(run)_OUTPUTS))
EXP2_SHARED_ANALYSIS_OUTPUTS := results/extended/exp2/analysis/network_handoffs.csv \
	results/extended/exp2/analysis/consumer_handoffs.csv \
	results/extended/exp2/analysis/analysis_audit.txt
EXP2_DISTINCT_ANALYSIS_OUTPUTS := results/extended/exp2/distinct/analysis/network_handoffs.csv \
	results/extended/exp2/distinct/analysis/consumer_handoffs.csv \
	results/extended/exp2/distinct/analysis/stream_recovery_diagnostics.csv \
	results/extended/exp2/distinct/analysis/analysis_audit.txt

$(EXP2_SHARED_ANALYSIS_OUTPUTS) &: experiment/tool/exp2/run_exp2_scale_analysis.py \
	experiment/tool/exp2/exp2_scale_metrics.py \
	experiment/tool/exp2/exp2_shared_config.py \
	experiment/tool/exp2/plot_exp2_scale.py \
	experiment/tool/analysis/mobility_event_metrics.py \
	experiment/tool/analysis/run_mobility_event_analysis.py \
	experiment/tool/analysis/extract_overhead_csv.py \
	experiment/tool/resources/ndn.lua \
	$(EXP2_SHARED_FORMAL_EVIDENCE)
	python3 -m experiment.tool.exp2.run_exp2_scale_analysis

$(EXP2_DISTINCT_ANALYSIS_OUTPUTS) &: experiment/tool/exp2/run_exp2_distinct_analysis.py \
	experiment/tool/exp2/exp2_distinct_metrics.py \
	experiment/tool/exp2/exp2_shared_config.py \
	experiment/tool/analysis/mobility_event_metrics.py \
	experiment/tool/analysis/run_mobility_event_analysis.py \
	experiment/tool/analysis/extract_overhead_csv.py \
	experiment/tool/resources/ndn.lua \
	$(EXP2_DISTINCT_FORMAL_EVIDENCE)
	python3 -m experiment.tool.exp2.run_exp2_distinct_analysis --all

# Formal Exp2 VM runs only. The last run pulls the serial chain, including Exp1.
.PHONY: experiment-exp2

experiment-exp2: $(EXP2_FORMAL_LAST)
