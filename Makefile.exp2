# Exp2-A shared stream, N=2 and N=4. These targets do not depend on baseline,
# solution, or Exp1 runs. One Exp2 VM is locked, so campaign targets run serially.

EXP2_WARMUP_S ?= 20
EXP2_TAIL_S ?= 30
EXP2_SHARED_ROOT := results/extended/exp2/shared
EXP2_N2_NODES := core agg1 agg2 acc1 acc2 acc3 acc4 acc5 acc6 producer consumer1 consumer2
EXP2_N4_NODES := $(EXP2_N2_NODES) consumer3 consumer4
EXP2_FULL_SEQUENCE := acc2,acc3,acc4,acc5,acc6,acc5,acc4,acc3,acc2
EXP2_FULL_RUNS := r1 r2 r3 r4 r5

EXP2_VM_PREREQS := scripts/run-in-vm.sh \
	box/solution/solution.$(PROVIDER).box \
	experiment/app/producer.cpp \
	experiment/app/consumer.cpp \
	experiment/app/optoflood-daemon.cpp \
	experiment/app/trust-schema.conf \
	experiment/extended/exp2/Vagrantfile \
	experiment/extended/exp2/Makefile \
	experiment/tool/exp.py \
	experiment/tool/exp2_shared_driver.py \
	experiment/tool/exp2_shared_config.py \
	experiment/tool/handoff_schedule.py \
	experiment/tool/check_exp2_shared_evidence.py

define exp2_shared_outputs
$(1)/campaign.txt \
$(1)/params.txt \
$(1)/handoffs.txt \
$(1)/topology.txt \
$(1)/producer.log \
$(1)/optoflood_producer.log \
$(foreach consumer,$(2),$(1)/$(consumer).log $(1)/optoflood_$(consumer).log) \
$(foreach node,$(3),$(1)/pcap_nodes/$(node).pcap) \
$(foreach node,$(3),$(1)/tcpdump_$(node).log) \
$(foreach node,$(3),$(1)/minindn-logs/$(node)/nfd.log $(1)/minindn-logs/$(node)/nlsr.log)
endef

comma := ,

EXP2_N2_SMOKE_OUTPUTS := $(call exp2_shared_outputs,$(EXP2_SHARED_ROOT)/n2/smoke,consumer1 consumer2,$(EXP2_N2_NODES))
EXP2_N4_SMOKE_OUTPUTS := $(call exp2_shared_outputs,$(EXP2_SHARED_ROOT)/n4/smoke,consumer1 consumer2 consumer3 consumer4,$(EXP2_N4_NODES))

$(EXP2_N2_SMOKE_OUTPUTS) &: $(EXP2_VM_PREREQS)
	RUN_IN_VM_PROFILE=exp2 MOBILITY_LOG_NODES="$(EXP2_N2_NODES)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) NLSR_HANDOFF_COUNT='1' NLSR_HANDOFF_SEQUENCE='acc2,acc3' NLSR_HANDOFF_INTERVALS='$(EXP2_WARMUP_S),$(EXP2_TAIL_S)' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='60' EXP2_ACTIVE_CONSUMERS='consumer1,consumer2' EXP2_SCHEDULE='smoke' EXP2_RUN_ID='smoke' EXP2_WARMUP_S='$(EXP2_WARMUP_S)' EXP2_TAIL_S='$(EXP2_TAIL_S)' EXP_REQUEST_INTERVAL_MS='20' make exp2-shared" sh $(EXP2_VM_PREREQS) $@

$(EXP2_N4_SMOKE_OUTPUTS) &: $(EXP2_VM_PREREQS)
	RUN_IN_VM_PROFILE=exp2 MOBILITY_LOG_NODES="$(EXP2_N4_NODES)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) NLSR_HANDOFF_COUNT='1' NLSR_HANDOFF_SEQUENCE='acc2,acc3' NLSR_HANDOFF_INTERVALS='$(EXP2_WARMUP_S),$(EXP2_TAIL_S)' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='60' EXP2_ACTIVE_CONSUMERS='consumer1,consumer2,consumer3,consumer4' EXP2_SCHEDULE='smoke' EXP2_RUN_ID='smoke' EXP2_WARMUP_S='$(EXP2_WARMUP_S)' EXP2_TAIL_S='$(EXP2_TAIL_S)' EXP_REQUEST_INTERVAL_MS='20' make exp2-shared" sh $(EXP2_VM_PREREQS) $@

define exp2_full_rule
EXP2_$(1)_$(2)_OUTPUTS := $$(call exp2_shared_outputs,$(EXP2_SHARED_ROOT)/$(3)/$(2),$(4),$(6))

$$(EXP2_$(1)_$(2)_OUTPUTS) &: $$(EXP2_VM_PREREQS)
	RUN_IN_VM_PROFILE=exp2 MOBILITY_LOG_NODES="$(6)" RUN_IN_VM_REMOTE_MAKE="$(SOLUTION_NLSR_ENV) NLSR_HANDOFF_COUNT='8' NLSR_HANDOFF_SEQUENCE='$(EXP2_FULL_SEQUENCE)' NLSR_HANDOFF_INTERVALS='' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='60' EXP2_ACTIVE_CONSUMERS='$(subst +,$(comma),$(5))' EXP2_SCHEDULE='full' EXP2_RUN_ID='$(2)' EXP_REQUEST_INTERVAL_MS='20' make exp2-shared" sh $$(EXP2_VM_PREREQS) $$@

.PHONY: experiment-exp2-shared-$(3)-$(2) analyze-exp2-shared-$(3)-$(2) check-exp2-shared-$(3)-$(2)

experiment-exp2-shared-$(3)-$(2): $$(EXP2_$(1)_$(2)_OUTPUTS)

analyze-exp2-shared-$(3)-$(2):
	python3 experiment/tool/run_exp2_shared_analysis.py $(EXP2_SHARED_ROOT)/$(3)/$(2)

check-exp2-shared-$(3)-$(2):
	python3 experiment/tool/check_exp2_shared_evidence.py $(EXP2_SHARED_ROOT)/$(3)/$(2)
endef

$(foreach run,$(EXP2_FULL_RUNS),$(eval $(call exp2_full_rule,N2,$(run),n2,consumer1 consumer2,consumer1+consumer2,$(EXP2_N2_NODES))))
$(foreach run,$(EXP2_FULL_RUNS),$(eval $(call exp2_full_rule,N4,$(run),n4,consumer1 consumer2 consumer3 consumer4,consumer1+consumer2+consumer3+consumer4,$(EXP2_N4_NODES))))

.PHONY: experiment-exp2-shared-n2-smoke experiment-exp2-shared-n4-smoke \
	check-exp2-shared-n2-smoke check-exp2-shared-n4-smoke \
	analyze-exp2-shared-n2-smoke analyze-exp2-shared-n4-smoke \
	experiment-exp2-shared-n2-full experiment-exp2-shared-n4-full

experiment-exp2-shared-n2-smoke: $(EXP2_N2_SMOKE_OUTPUTS)

experiment-exp2-shared-n4-smoke: $(EXP2_N4_SMOKE_OUTPUTS)

check-exp2-shared-n2-smoke:
	python3 experiment/tool/check_exp2_shared_evidence.py $(EXP2_SHARED_ROOT)/n2/smoke

check-exp2-shared-n4-smoke:
	python3 experiment/tool/check_exp2_shared_evidence.py $(EXP2_SHARED_ROOT)/n4/smoke

analyze-exp2-shared-n2-smoke:
	python3 experiment/tool/run_exp2_shared_analysis.py $(EXP2_SHARED_ROOT)/n2/smoke

analyze-exp2-shared-n4-smoke:
	python3 experiment/tool/run_exp2_shared_analysis.py $(EXP2_SHARED_ROOT)/n4/smoke

experiment-exp2-shared-n2-full:
	$(MAKE) experiment-exp2-shared-n2-r1
	$(MAKE) experiment-exp2-shared-n2-r2
	$(MAKE) experiment-exp2-shared-n2-r3
	$(MAKE) experiment-exp2-shared-n2-r4
	$(MAKE) experiment-exp2-shared-n2-r5

experiment-exp2-shared-n4-full:
	$(MAKE) experiment-exp2-shared-n4-r1
	$(MAKE) experiment-exp2-shared-n4-r2
	$(MAKE) experiment-exp2-shared-n4-r3
	$(MAKE) experiment-exp2-shared-n4-r4
	$(MAKE) experiment-exp2-shared-n4-r5

.PHONY: analyze-exp2-scale

analyze-exp2-scale:
	python3 experiment/tool/run_exp2_scale_analysis.py
