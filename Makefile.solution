# Rules to run the OptoFlood experiment.
#
# Five independent runs of the same 8-handoff round trip as the baseline.
# MAIN_HANDOFF_* comes from Makefile.baseline. Intervals are sampled again
# inside each run; they are not paired with a baseline run.
# The five VM recipes are order-only chained, and the first waits for
# test/.validate_ok and the last baseline run, so baseline -> test -> solution
# stays intact under `make -j`.

SOLUTION_INPUTS = box/solution/solution.$(PROVIDER).box \
                  experiment/app/producer.cpp \
                  experiment/app/consumer.cpp \
                  experiment/app/optoflood-daemon.cpp \
                  experiment/app/trust-schema.conf \
                  experiment/solution/Vagrantfile \
                  experiment/solution/Makefile \
                  experiment/tool/exp.py

SOLUTION_HANDOFF_ENV = $(MAIN_HANDOFF_ENV)

# NLSR experiment-policy switches for the solution runs.
# Override on the command line for ablation cells, e.g.
# SOLUTION_NLSR_RESULT_DRIVEN=off, SOLUTION_NLSR_CORRIDOR_PRIORITISED_ROUTING=off,
# or SOLUTION_NLSR_EVENT_DRIVEN_VERIFICATION_TIMEOUT_MS=0.
# Full-solution defaults: result-driven on, event-driven on, Corridor on,
# Commit-C publication delay 1 s, and event-driven verification timeout 50 ms.
# NLSR's own nlsr.conf remains conservative (Corridor off, timeout 0/inherit).
# The baseline box runs upstream NLSR, which does not read these keys.
SOLUTION_NLSR_RESULT_DRIVEN ?= on
SOLUTION_NLSR_EVENT_DRIVEN_VERIFICATION ?= on
SOLUTION_NLSR_CORRIDOR_PRIORITISED_ROUTING ?= on
SOLUTION_NLSR_CORRIDOR_ADJ_LSA_SYNC_PUBLISH_DELAY ?= 1
SOLUTION_NLSR_EVENT_DRIVEN_VERIFICATION_TIMEOUT_MS ?= 50
export SOLUTION_NLSR_RESULT_DRIVEN
export SOLUTION_NLSR_EVENT_DRIVEN_VERIFICATION
export SOLUTION_NLSR_CORRIDOR_PRIORITISED_ROUTING
export SOLUTION_NLSR_CORRIDOR_ADJ_LSA_SYNC_PUBLISH_DELAY
export SOLUTION_NLSR_EVENT_DRIVEN_VERIFICATION_TIMEOUT_MS
# Single line: a backslash continuation is dropped under CRLF checkouts, which
# previously left NLSR_EVENT_DRIVEN_ADJACENCY_VERIFICATION unset in the VM.
SOLUTION_NLSR_ENV = NLSR_RESULT_DRIVEN_ADJ_LSA_BUILD='$(SOLUTION_NLSR_RESULT_DRIVEN)' NLSR_EVENT_DRIVEN_ADJACENCY_VERIFICATION='$(SOLUTION_NLSR_EVENT_DRIVEN_VERIFICATION)' NLSR_CORRIDOR_PRIORITISED_ROUTING='$(SOLUTION_NLSR_CORRIDOR_PRIORITISED_ROUTING)' NLSR_CORRIDOR_ADJ_LSA_SYNC_PUBLISH_DELAY='$(SOLUTION_NLSR_CORRIDOR_ADJ_LSA_SYNC_PUBLISH_DELAY)' NLSR_EVENT_DRIVEN_VERIFICATION_TIMEOUT_MS='$(SOLUTION_NLSR_EVENT_DRIVEN_VERIFICATION_TIMEOUT_MS)'

solution_run_outputs = $(addprefix results/solution/$(1)/,$(EXPERIMENT_RUN_FILES))
SOLUTION_VM_ORDER := $(addprefix solution/,$(EXPERIMENT_RUN_IDS))
SOLUTION_RESULTS := $(foreach run,$(EXPERIMENT_RUN_IDS),$(call solution_run_outputs,$(run)))

# $(1) run id, $(2) order-only prerequisites (never empty).
define emit_solution_run
$(call solution_run_outputs,$(1)) &: scripts/run-in-vm.sh $$(SOLUTION_INPUTS) | $(2)
	RUN_IN_VM_CLEAR_LOCAL=1 RUN_IN_VM_REMOTE_MAKE="$$(SOLUTION_HANDOFF_ENV) $$(SOLUTION_NLSR_ENV) make all" sh $$^ $$@
endef

SOLUTION_CHAIN_PREV := test/.validate_ok $(BASELINE_LAST_RUN_OUTPUTS)

define queue_solution_run
$(eval $(call emit_solution_run,$(1),$(SOLUTION_CHAIN_PREV)))
$(eval SOLUTION_CHAIN_PREV := $(call solution_run_outputs,$(1)))
endef

$(foreach run,$(EXPERIMENT_RUN_IDS),$(call queue_solution_run,$(run)))

# Host-side mobility-event analysis. Raw captures are not Make prerequisites.

SOLUTION_COMPARE_OUTPUTS := results/solution/mobility_events.csv \
                            results/solution/mobility_event_audit.txt \
                            results/solution_service_recovery_time.pdf \
                            results/solution_content_loss_fraction.pdf \
                            results/solution_nlsr_control_rate.pdf \
                            results/solution_recovery_flooding_volume.pdf

# Legacy manuscript compatibility. Kept off the grouped rule so a missing FCR
# PDF does not invalidate the active solution figures, including RFV.
SOLUTION_LEGACY_FCR := results/solution_forwarding_cost_ratio.pdf

$(SOLUTION_COMPARE_OUTPUTS) &: experiment/tool/run_mobility_event_analysis.py \
                              experiment/tool/mobility_event_metrics.py \
                              experiment/tool/plot_mobility_event_metrics.py
	python3 experiment/tool/run_mobility_event_analysis.py analyze-solution

$(SOLUTION_LEGACY_FCR): experiment/tool/run_mobility_event_analysis.py \
                        experiment/tool/mobility_event_metrics.py \
                        experiment/tool/plot_mobility_event_metrics.py
	python3 experiment/tool/run_mobility_event_analysis.py analyze-solution
