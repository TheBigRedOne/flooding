# Rules for Exp 1 (Request Interval and Video Quality).
#
# A solution-only sweep over the consumer/producer request interval. The network
# delay is held at the main-evaluation value; only EXP_REQUEST_INTERVAL_MS
# varies. The handoff schedule is the deterministic K=16 double round trip
# (acc2..acc6..acc2 x2) with zero jitter, so every interval value faces the same
# mobility timeline and the comparison isolates the request interval.

EXT1_INTERVALS = 10 20 30 40 50

EXT1_HANDOFF_SEQUENCE = acc2,acc3,acc4,acc5,acc6,acc5,acc4,acc3,acc2,acc3,acc4,acc5,acc6,acc5,acc4,acc3,acc2
EXT1_HANDOFF_ENV = NLSR_HANDOFF_COUNT='16' NLSR_HANDOFF_INTERVAL_BASE='90' NLSR_HANDOFF_INTERVAL_JITTER='0' NLSR_HANDOFF_SEQUENCE='$(EXT1_HANDOFF_SEQUENCE)'

# Raw artifacts produced per interval directory (XXX is the i<interval> token).
EXT1_EXPERIMENT_OUTPUTS = results/extended/exp1/XXX/consumer_capture.pcap \
                          results/extended/exp1/XXX/pcap_nodes/core.pcap \
                          results/extended/exp1/XXX/pcap_nodes/agg1.pcap \
                          results/extended/exp1/XXX/pcap_nodes/agg2.pcap \
                          results/extended/exp1/XXX/pcap_nodes/acc1.pcap \
                          results/extended/exp1/XXX/pcap_nodes/acc2.pcap \
                          results/extended/exp1/XXX/pcap_nodes/acc3.pcap \
                          results/extended/exp1/XXX/pcap_nodes/acc4.pcap \
                          results/extended/exp1/XXX/pcap_nodes/acc5.pcap \
                          results/extended/exp1/XXX/pcap_nodes/acc6.pcap \
                          results/extended/exp1/XXX/pcap_nodes/producer.pcap \
                          results/extended/exp1/XXX/pcap_nodes/consumer.pcap \
                          results/extended/exp1/XXX/params.txt \
                          results/extended/exp1/XXX/handoffs.txt

EXT1_RAW_OUTPUTS = $(subst XXX,i10,$(EXT1_EXPERIMENT_OUTPUTS)) \
                   $(subst XXX,i20,$(EXT1_EXPERIMENT_OUTPUTS)) \
                   $(subst XXX,i30,$(EXT1_EXPERIMENT_OUTPUTS)) \
                   $(subst XXX,i40,$(EXT1_EXPERIMENT_OUTPUTS)) \
                   $(subst XXX,i50,$(EXT1_EXPERIMENT_OUTPUTS))

EXT1_SENSITIVITY_OUTPUTS = results/extended/exp1/exp1_service_recovery_time.pdf \
                           results/extended/exp1/exp1_content_loss_fraction.pdf \
                           results/extended/exp1/exp1_explicit_flood_rate.pdf

EXT1_TIMELINE_OUTPUT = results/extended/exp1/exp1_delivery_timeline.pdf

# Absolute playout deadline (ms) drawn on the per-frame delivery timeline.
EXT1_PRIMARY_DEADLINE = 200

# --- Experiment runs (solution box/VM; SOLUTION_INPUTS from Makefile.solution) ---
#
# The first interval runs after the solution experiment; each subsequent
# interval is chained to the previous one through order-only prerequisites, so
# the shared solution VM stage stays strictly serial under make -j N (concurrent
# `vagrant up` against the same Vagrantfile would race).

$(subst XXX,i10,$(EXT1_EXPERIMENT_OUTPUTS)) &: scripts/run-in-vm.sh $(SOLUTION_INPUTS) | test/.validate_ok $(SOLUTION_RESULTS)
	RUN_IN_VM_CLEAR_LOCAL=1 RUN_IN_VM_REMOTE_MAKE="EXP_REQUEST_INTERVAL_MS='10' $(EXT1_HANDOFF_ENV) $(SOLUTION_NLSR_ENV) make all" sh $^ $@

$(subst XXX,i20,$(EXT1_EXPERIMENT_OUTPUTS)) &: scripts/run-in-vm.sh $(SOLUTION_INPUTS) | $(subst XXX,i10,$(EXT1_EXPERIMENT_OUTPUTS))
	RUN_IN_VM_CLEAR_LOCAL=1 RUN_IN_VM_REMOTE_MAKE="EXP_REQUEST_INTERVAL_MS='20' $(EXT1_HANDOFF_ENV) $(SOLUTION_NLSR_ENV) make all" sh $^ $@

$(subst XXX,i30,$(EXT1_EXPERIMENT_OUTPUTS)) &: scripts/run-in-vm.sh $(SOLUTION_INPUTS) | $(subst XXX,i20,$(EXT1_EXPERIMENT_OUTPUTS))
	RUN_IN_VM_CLEAR_LOCAL=1 RUN_IN_VM_REMOTE_MAKE="EXP_REQUEST_INTERVAL_MS='30' $(EXT1_HANDOFF_ENV) $(SOLUTION_NLSR_ENV) make all" sh $^ $@

$(subst XXX,i40,$(EXT1_EXPERIMENT_OUTPUTS)) &: scripts/run-in-vm.sh $(SOLUTION_INPUTS) | $(subst XXX,i30,$(EXT1_EXPERIMENT_OUTPUTS))
	RUN_IN_VM_CLEAR_LOCAL=1 RUN_IN_VM_REMOTE_MAKE="EXP_REQUEST_INTERVAL_MS='40' $(EXT1_HANDOFF_ENV) $(SOLUTION_NLSR_ENV) make all" sh $^ $@

$(subst XXX,i50,$(EXT1_EXPERIMENT_OUTPUTS)) &: scripts/run-in-vm.sh $(SOLUTION_INPUTS) | $(subst XXX,i40,$(EXT1_EXPERIMENT_OUTPUTS))
	RUN_IN_VM_CLEAR_LOCAL=1 RUN_IN_VM_REMOTE_MAKE="EXP_REQUEST_INTERVAL_MS='50' $(EXT1_HANDOFF_ENV) $(SOLUTION_NLSR_ENV) make all" sh $^ $@

# Host-side mobility-event analysis, including the delivery timeline.
# The recipe reads existing captures and does not list them as prerequisites.

EXT1_ANALYSIS_OUTPUTS = $(EXT1_SENSITIVITY_OUTPUTS) \
                        $(EXT1_TIMELINE_OUTPUT) \
                        results/extended/exp1/mobility_events.csv \
                        results/extended/exp1/mobility_event_audit.txt

$(EXT1_ANALYSIS_OUTPUTS) &: experiment/tool/run_mobility_event_analysis.py \
                           experiment/tool/mobility_event_metrics.py \
                           experiment/tool/plot_mobility_event_metrics.py \
                           experiment/tool/plot_delivery_timeline.py \
                           experiment/tool/ndn.lua
	python3 experiment/tool/run_mobility_event_analysis.py analyze-exp1 --deadline $(EXT1_PRIMARY_DEADLINE)
